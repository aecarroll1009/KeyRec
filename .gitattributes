# Normalise line endings for text, and mark the data/result formats binary so
# git never attempts EOL conversion or a line-based diff on them. Without this
# an audio clip or a checkpoint can be silently corrupted by CRLF translation
# on a Windows checkout.
* text=auto

*.wav   binary
*.m4a   binary
*.npz   binary
*.pt    binary
*.png   binary

*.ps1   text eol=crlf
